{
  "name": "device-operate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "predev": "npm run build:native",
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently.js \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "node ./node_modules/vite/bin/vite.js --host 127.0.0.1",
    "test": "node --test",
    "build:native": "bash scripts/build_file_associations_helper.sh",
    "build": "npm run build:native && npm run build:assets && node ./node_modules/vite/bin/vite.js build",
    "start": "NODE_ENV=production node server/index.js",
    "electron": "npm run build && node ./node_modules/electron/cli.js .",
    "package:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ bash scripts/package_mac.sh --mac dir",
    "build:assets": "node scripts/electron/make_tray_icon.mjs",
    "verify:pi": "node scripts/verify_pi_runtime.mjs",
    "dist:mas": "npm run build && node scripts/electron/prepare-electron-mas.mjs && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac mas --dir -c.electronDist=\"$(cat .cache/electron-mas-dir)\" -c.directories.output=release-mas && node scripts/electron/sign-mas-app.mjs && node scripts/electron/finalize-mas-package.mjs",
    "dist:developer-id": "npm run build && electron-builder --mac dir -c.mac.identity=E3882839B77314A36CEAD6ACD338B2FC61A059B7 -c.directories.output=release-dev-id"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "d3-geo": "^3.1.1",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0",
    "vite": "^6.0.7",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.device-operate.my-macos",
    "productName": "我的macOS",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "build/trayTemplate.png",
      "server/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*",
      "scripts/electron/sign-mas.cjs",
      "scripts/electron/finalize-mas-package.mjs",
      "scripts/electron/sign-mas-app.mjs"
    ],
    "asarUnpack": [
      "server/agent/**/*",
      "server/bin/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "我的macOS 需要读取和管理登录项，并打开相关系统设置。",
        "ITSAppUsesNonExemptEncryption": false,
        "ElectronTeamID": "27F3J29B8W"
      },
      "target": [
        "dir"
      ],
      "bundleVersion": "2026111101",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "gatekeeperAssess": false
    },
    "asar": true,
    "npmRebuild": false,
    "mas": {
      "category": "public.app-category.utilities",
      "sign": "scripts/electron/sign-mas.cjs",
      "hardenedRuntime": false,
      "type": "distribution",
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/My_macOS_Mac_App_Store_20261111.provisionprofile"
    }
  }
}
