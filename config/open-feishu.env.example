# Optional config for scripts/open_feishu_android.sh.
# Copy this to ~/.config/device-operate/open-feishu.env and edit locally.

# Use this when more than one Android device may be connected.
# DEVICE_SERIAL=your_adb_device_serial

# Only set this if you accept storing the phone PIN in a local plaintext file.
# The script will type it after waking and swiping up.
# ANDROID_PIN=123456

# Optional: use wireless debugging when USB ADB does not enumerate on this Mac.
# Set this to the Wireless debugging "IP address & Port" connect endpoint after pairing.
# ADB_CONNECT=192.168.1.23:37123

# Feishu China is usually com.ss.android.lark; Lark international is often com.larksuite.suite.
# Set one explicit package if auto-detection does not work.
# FEISHU_PACKAGE=com.ss.android.lark

# Or override the candidate list.
# FEISHU_PACKAGES="com.ss.android.lark com.larksuite.suite"

# Reminder shown on the Mac after Feishu opens.
# REMINDER_TITLE=飞书提醒
# REMINDER_TEXT=请进入假勤快机器人，由你本人手动完成打卡。

# Seconds to keep Feishu open before force-stopping it and locking the phone.
# FEISHU_CLOSE_DELAY_SECONDS=10

# Seconds to wait for adb to reconnect before failing.
# ADB_WAIT_SECONDS=20

# Optional random delay after the scheduled trigger.
# Example: launchd triggers at 09:00, this runs the action randomly between 09:00 and 09:30.
# RANDOM_DELAY_MIN_SECONDS=0
# RANDOM_DELAY_MAX_SECONDS=1800


FEISHU_CLOSE_DELAY_SECONDS=30
RANDOM_DELAY_MAX_SECONDS=1800
